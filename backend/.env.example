# Нусха гиред: cp .env.example .env
ENVIRONMENT=development
# SQLite (барои оғоз) ё PostgreSQL:
# DATABASE_URL=postgresql+psycopg://tuyona:tuyona@localhost:5432/tuyona
DATABASE_URL=sqlite:///./tuyona.db
# Дар production ҳатман тағйир диҳед:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-in-production-use-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_MB=5
# Ороишгоҳи AI: FASHN_API_KEY аз https://fashn.ai (пулакӣ); бе он — модели ройгони Hugging Face (HF_TOKEN квотаро зиёд мекунад).
FASHN_API_KEY=
HF_TOKEN=
TRYON_DAILY_LIMIT=20
# Ёрдамчии AI (чат): Claude Opus 5.5. Калид: https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium
ASSISTANT_HOURLY_LIMIT=30
# Ё ройгон (бе корти бонкӣ) — Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Ё бе калид — модели маҳаллӣ тавассути Ollama (https://ollama.com), масалан:
# OLLAMA_MODEL=gemma4:12b-it-qat   (ollama pull gemma4:12b-it-qat — 7.2 ГБ, барои видеокартаи 8 ГБ)
# Воридшавӣ бо Google: OAuth Client ID (Web application) аз https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: https://tuyona.king.tj ва http://localhost:5173
GOOGLE_CLIENT_ID=
